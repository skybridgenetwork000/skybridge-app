<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingLeft="18dp"
		android:paddingTop="10dp"
		android:paddingRight="18dp"
		android:paddingBottom="5dp"
		android:gravity="center_horizontal"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="30dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<ImageView
				android:id="@+id/imageview1"
				android:layout_width="43dp"
				android:layout_height="42dp"
				android:padding="10dp"
				android:background="#212121"
				android:src="@drawable/icon_arrow_back_round"
				android:scaleType="fitCenter" />
			<TextView
				android:id="@+id/textview2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="15dp"
				android:text="My Profile"
				android:textSize="20sp"
				android:textColor="#000000" />
		</LinearLayout>
		<ScrollView
			android:id="@+id/vscroll1"
			android:layout_width="match_parent"
			android:layout_height="match_parent">
			<LinearLayout
				android:id="@+id/linear18"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@android:color/transparent"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear5"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:background="#F5F5F5"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear6"
						android:layout_width="match_parent"
						android:layout_height="38dp"
						android:background="@android:color/transparent"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear7"
							android:layout_width="110dp"
							android:layout_height="match_parent"
							android:layout_marginRight="3dp"
							android:paddingLeft="8dp"
							android:paddingRight="8dp"
							android:gravity="center_vertical"
							android:orientation="vertical">
							<TextView
								android:id="@+id/textview6"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:text="First Name"
								android:textSize="14sp"
								android:textColor="#9E9E9E" />
						</LinearLayout>
						<TextView
							android:id="@+id/textview5"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:text="Linexware"
							android:textSize="14sp"
							android:textColor="#000000"
							android:alpha="0.8" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear3"
						android:layout_width="match_parent"
						android:layout_height="38dp"
						android:layout_marginTop="4dp"
						android:background="@android:color/transparent"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear4"
							android:layout_width="110dp"
							android:layout_height="match_parent"
							android:layout_marginRight="3dp"
							android:paddingLeft="8dp"
							android:paddingRight="8dp"
							android:gravity="center_vertical"
							android:orientation="vertical">
							<TextView
								android:id="@+id/textview3"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:text="Last Name"
								android:textSize="14sp"
								android:textColor="#9E9E9E" />
						</LinearLayout>
						<TextView
							android:id="@+id/textview4"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:text="-"
							android:textSize="14sp"
							android:textColor="#000000"
							android:alpha="0.8" />
					</LinearLayout>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear8"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="15dp"
					android:padding="8dp"
					android:background="#F5F5F5"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear9"
						android:layout_width="match_parent"
						android:layout_height="38dp"
						android:background="@android:color/transparent"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear12"
							android:layout_width="110dp"
							android:layout_height="match_parent"
							android:layout_marginRight="3dp"
							android:paddingLeft="8dp"
							android:paddingRight="8dp"
							android:gravity="center_vertical"
							android:orientation="vertical">
							<TextView
								android:id="@+id/textview10"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:text="Email"
								android:textSize="14sp"
								android:textColor="#9E9E9E" />
						</LinearLayout>
						<TextView
							android:id="@+id/textview9"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:text="linexware\@gmail.com"
							android:textSize="14sp"
							android:textColor="#000000"
							android:singleLine="true"
							android:alpha="0.8"
							android:layout_weight="1" />
					</LinearLayout>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear13"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="15dp"
					android:padding="8dp"
					android:background="#F5F5F5"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear14"
						android:layout_width="match_parent"
						android:layout_height="38dp"
						android:background="@android:color/transparent"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear17"
							android:layout_width="110dp"
							android:layout_height="match_parent"
							android:layout_marginRight="3dp"
							android:paddingLeft="8dp"
							android:paddingRight="8dp"
							android:gravity="center_vertical"
							android:orientation="vertical">
							<TextView
								android:id="@+id/textview14"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:text="Account ID"
								android:textSize="14sp"
								android:textColor="#9E9E9E" />
						</LinearLayout>
						<TextView
							android:id="@+id/textview13"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:text="1234567890"
							android:textSize="14sp"
							android:textColor="#000000"
							android:alpha="0.8"
							android:layout_weight="1" />
						<ImageView
							android:id="@+id/imageview2"
							android:layout_width="38dp"
							android:layout_height="38dp"
							android:padding="9dp"
							android:background="@android:color/transparent"
							android:src="@drawable/icon_copy_all_round"
							android:scaleType="fitCenter" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear15"
						android:layout_width="match_parent"
						android:layout_height="38dp"
						android:layout_marginTop="4dp"
						android:background="@android:color/transparent"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear16"
							android:layout_width="110dp"
							android:layout_height="match_parent"
							android:layout_marginRight="3dp"
							android:paddingLeft="8dp"
							android:paddingRight="8dp"
							android:gravity="center_vertical"
							android:orientation="vertical">
							<TextView
								android:id="@+id/textview12"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:text="KYC Status"
								android:textSize="14sp"
								android:textColor="#9E9E9E" />
						</LinearLayout>
						<TextView
							android:id="@+id/textview11"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:paddingLeft="10dp"
							android:paddingTop="3dp"
							android:paddingRight="10dp"
							android:paddingBottom="3dp"
							android:background="@android:color/transparent"
							android:gravity="center_vertical"
							android:text="Unknown"
							android:textSize="12sp"
							android:textColor="#212121" />
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
		</ScrollView>
	</LinearLayout>
</LinearLayout>
